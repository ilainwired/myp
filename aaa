variables
{
  const int INTERNAL_BUFFER_DEPTH = 3;
  const int INTERNAL_BUFFER_SIZE  = 128;

  int internal_buffer_head  = 0;  /* Next read position */
  int internal_buffer_tail  = 0;  /* Next write position */
  int internal_buffer_count = 0;

  byte internal_buffer[INTERNAL_BUFFER_DEPTH][INTERNAL_BUFFER_SIZE];
}


void ReportCom(byte data[])
{
  if ((@sysvar::ReportBuffer_OWN == 0) &&
      (internal_buffer_count == 0))
  {
    sysSetVariableData(
      sysvar::ReportBuffer,
      data,
      INTERNAL_BUFFER_SIZE
    );

    @sysvar::ReportBuffer_OWN = 1;
  }
  else
  {
    /* Push */
    if (internal_buffer_count < INTERNAL_BUFFER_DEPTH)
    {
      memcpy(
        internal_buffer[internal_buffer_tail],
        data,
        INTERNAL_BUFFER_SIZE
      );

      internal_buffer_tail =
        (internal_buffer_tail + 1)
        % INTERNAL_BUFFER_DEPTH;

      internal_buffer_count++;
    }
    else
    {
      write("ReportCom: Critical Error: buffer overflow");
    }
  }
}


on sysvar_change sysvar::ReportBuffer_OWN
{
  if ((@this == 0) &&
      (internal_buffer_count > 0))
  {
    /* Pop */
    sysSetVariableData(
      sysvar::ReportBuffer,
      internal_buffer[internal_buffer_head],
      INTERNAL_BUFFER_SIZE
    );

    internal_buffer_head =
      (internal_buffer_head + 1)
      % INTERNAL_BUFFER_DEPTH;

    internal_buffer_count--;

    @this = 1;
  }
}
